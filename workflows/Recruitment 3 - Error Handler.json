      "parameters": {
        "sendTo": "YOUR_SENDTO",
        "subject": "=[HEARTBEAT] {{ $json.stuckCount }} applications waiting more than 3 hours",
        "message": "=<div style=\"background:#f4f5f7;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;\">\n    <tr><td style=\"background:#ea580c;padding:24px 32px;color:#ffffff;\">\n      <div style=\"font-size:12px;letter-spacing:1px;text-transform:uppercase;opacity:.85;\">System Heartbeat</div>\n      <div style=\"font-size:22px;font-weight:bold;margin-top:6px;\">Pipeline Stalled</div>\n    </td></tr>\n    <tr><td style=\"padding:26px 32px;color:#1f2937;font-size:15px;line-height:1.6;\">\n      <p><b>{{ $json.stuckCount }}</b> application(s) have been waiting in Status <b>new</b> for more than 3 hours (oldest: {{ $json.oldestHours }} h). The batch evaluation workflow is probably not running.</p>\n      \n      <ul>{{ $json.listHtml }}</ul>\n      \n      <p style=\"color:#6b7280;font-size:12px;margin-top:24px;border-top:1px solid #e5e7eb;padding-top:16px;\">\n        Fingerprint: <code>Recruitment 2 - Batch Evaluation (AI Screening) | Heartbeat | heartbeat</code>\n      </p>\n    </td></tr>\n  </table>\n</div>",
        "options": {
          "appendAttribution": false
        }
